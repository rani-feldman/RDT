# RDT workspace. Saved by RDT, so comments are not kept.
profile = "../sim/examples/default_profile.toml"
poll_ms = 500

[connection]
transport = "tcp"
address   = "127.0.0.1:5025"

[[mcu]]
id       = 0
name     = "Interface"
elf      = "../Firmware/GAC_INTERFACE_M7.elf"
identity = "firmware_name"

[[mcu.ranges]]
name  = "GPIOA"
start = 0x48000000
size  = 0x400

[[tab]]
name = "Motor"

[[tab.watch]]
expr = "Interface:shared_setting"

[[tab]]
name = "System"

[[tab.watch]]
expr   = "main:tick_count"
format = "hex"

[[tab.watch]]
expr = "motorctl:temperature"
poll = "manual"
unit = "degC"

[[tab.watch]]
expr      = "main:motor.mode"
read_only = true

