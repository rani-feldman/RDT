@echo off
rem Writes build_id.c next to this file with a new ID on every build, for RDT's ELF identity
rem check (SYM-8). Keil: Options for Target > User > Before Build/Rebuild > Run #1.
rem The ID is the build time plus 8 random hex digits, e.g. 20261014-091530-3f9a1c2e.
for /f "usebackq delims=" %%i in (`powershell -NoProfile -Command "(Get-Date -Format 'yyyyMMdd-HHmmss') + '-' + [guid]::NewGuid().ToString('N').Substring(0,8)"`) do set "RDT_ID=%%i"
if not defined RDT_ID (
    echo make_build_id: could not get an ID from PowerShell
    exit /b 1
)
> "%~dp0build_id.c" echo /* Generated by make_build_id.bat before every build; do not edit. Read by RDT. */
>> "%~dp0build_id.c" echo __attribute__((used)) const char fw_build_id[] = "%RDT_ID%";
echo make_build_id: fw_build_id = %RDT_ID%
